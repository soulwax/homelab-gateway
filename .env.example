# Cloudflare
CF_TOKEN="your-cloudflare-api-token"
CF_ZONE_ID="your-zone-id"

# Domain managed by this machine
DOMAIN="yourdomain.tld"

# Network interface with the public IPv6 address (ip -6 addr show scope global)
IFACE="your-network-interface"

# Certbot credential file for DNS challenge
CF_CREDENTIALS="/etc/letsencrypt/cloudflare/yourdomain.ini"

# Optional: extra root domains, separated by spaces or commas.
# Each entry is domain:cloudflare-zone-id and is managed as DNS-only A/AAAA.
ADDITIONAL_DOMAINS="otherdomain.tld:other-zone-id"
